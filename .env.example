# Base URL for the FastAPI service — must be publicly reachable from the browser.
# Used at build time (baked into the static HTML/JS). The site is fully static — no SSR.
# Do NOT add a trailing slash.
PUBLIC_API_URL=https://api.kaianolevine.com

# Cloudflare Turnstile site key for the gated /booking/ and /resume/ pages.
# PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Origin for canonical / Open Graph URLs. Defaults to https://software.kaianolevine.com.
# PUBLIC_SITE_URL=
