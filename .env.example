# website-astro-software — the names the site reads. Names only: copy this
# to .env and fill in values for local development; in production they are
# Cloudflare Pages environment variables. All are read at build time and
# baked into the static HTML/JS, so every one is public. Uncommented names
# are required; commented ones have a default.

# Base URL of api-kaianolevine-com, reachable from the browser. No trailing
# slash.
PUBLIC_API_URL=

# Cloudflare Turnstile site key for the gated /booking/ and /resume/ pages.
# Unset, the widget has no key.
# PUBLIC_TURNSTILE_SITE_KEY=

# Origin for canonical and Open Graph URLs. Defaults to
# https://software.kaianolevine.com.
# PUBLIC_SITE_URL=
