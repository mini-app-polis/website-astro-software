---
import { REPO_FILTERS, REPO_FILTER_LABELS } from "../lib/repos";
---

<section class="space-y-4" data-repo-status>
  <div
    class="hidden rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300"
    data-repo-stale
  >
    GitHub could not be reached. Showing the last good snapshot, taken
    <span data-repo-stale-age>—</span>.
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-repo-totals>
    {[
      { key: "repositories", label: "Repositories" },
      { key: "attention", label: "Not passing" },
      { key: "pull_requests", label: "Open PRs" },
      { key: "issues", label: "Open issues" },
    ].map((tile) => (
      <div class="rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3 shadow-soft">
        <div class="text-xs font-mono text-slate-400">{tile.label}</div>
        <div
          class="mt-1 font-display text-2xl tracking-tight text-slate-100"
          data-repo-total={tile.key}
        >
          —
        </div>
      </div>
    ))}
  </div>

  <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 shadow-soft">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h3 class="font-display text-xl tracking-tight">Listed repositories</h3>
        <p class="mt-1 text-sm text-slate-400" data-repo-subtitle>
          Default-branch check rollup, open pull requests and open issues
        </p>
      </div>
      <label class="sm:w-64">
        <span class="sr-only">Filter repositories by name</span>
        <input
          type="search"
          placeholder="Filter by name or language"
          class="w-full rounded-lg border border-white/10 bg-black/20 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500"
          data-repo-search
        />
      </label>
    </div>

    <div class="mt-4 flex flex-wrap gap-2" data-repo-filters>
      {REPO_FILTERS.map((filter) => (
        <button
          type="button"
          class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs font-mono text-slate-300 transition-colors hover:border-white/20"
          data-repo-filter={filter}
          data-selected={filter === "all" ? "true" : "false"}
          aria-pressed={filter === "all" ? "true" : "false"}
        >
          {REPO_FILTER_LABELS[filter]}
          <span class="ml-1 text-slate-500" data-repo-filter-count>—</span>
        </button>
      ))}
    </div>

    <div class="mt-5 space-y-2" data-repo-list>
      {Array.from({ length: 5 }).map(() => (
        <div class="rounded-lg border border-white/5 bg-black/10 px-4 py-3">
          <div class="h-4 w-52 animate-pulse rounded bg-white/10"></div>
          <div class="mt-2 h-4 w-80 max-w-full animate-pulse rounded bg-white/10"></div>
        </div>
      ))}
    </div>

    <p class="mt-5 hidden text-sm text-slate-500" data-repo-empty>
      No repositories match this filter.
    </p>

    <div class="mt-3 space-y-2" data-repo-private></div>

    <p class="mt-4 text-xs text-slate-500" data-repo-footer>—</p>
  </div>

  <script>
    import {
      buildClass,
      buildDotClass,
      buildLabel,
      esc,
      matchesFilter,
      normalizeBuild,
      normalizeFilter,
      REPO_FILTERS,
      type RepoFilter,
      type RepoRow,
      type RepoStatusPayload,
    } from "../lib/repos";

    const rootEl = document.querySelector<HTMLElement>("[data-repo-status]");
    if (!rootEl) throw new Error("RepoStatus root not found");
    const root: HTMLElement = rootEl;

    const list = root.querySelector<HTMLElement>("[data-repo-list]");
    const privates = root.querySelector<HTMLElement>("[data-repo-private]");
    const empty = root.querySelector<HTMLElement>("[data-repo-empty]");
    const footer = root.querySelector<HTMLElement>("[data-repo-footer]");
    const stale = root.querySelector<HTMLElement>("[data-repo-stale]");
    const search = root.querySelector<HTMLInputElement>("[data-repo-search]");
    const subtitle = root.querySelector<HTMLElement>("[data-repo-subtitle]");
    if (!list || !privates || !empty || !footer || !stale || !search || !subtitle) {
      throw new Error("RepoStatus markup is incomplete");
    }
    // Re-bound to non-nullable consts so the narrowing above holds inside
    // every closure below without an assertion at each use.
    const listEl: HTMLElement = list;
    const privateEl: HTMLElement = privates;
    const emptyEl: HTMLElement = empty;
    const footerEl: HTMLElement = footer;
    const staleEl: HTMLElement = stale;
    const searchEl: HTMLInputElement = search;
    const subtitleEl: HTMLElement = subtitle;

    const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });

    function relativeTime(iso: string | null | undefined): string {
      if (!iso) return "\u2014";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "\u2014";
      const sec = Math.round((d.getTime() - Date.now()) / 1000);
      if (Math.abs(sec) < 60) return rtf.format(sec, "second");
      const min = Math.round(sec / 60);
      if (Math.abs(min) < 60) return rtf.format(min, "minute");
      const hr = Math.round(min / 60);
      if (Math.abs(hr) < 24) return rtf.format(hr, "hour");
      const day = Math.round(hr / 24);
      if (Math.abs(day) < 30) return rtf.format(day, "day");
      return rtf.format(Math.round(day / 30), "month");
    }

    function plural(n: number, one: string, many: string): string {
      return `${n} ${n === 1 ? one : many}`;
    }

    function notPassing(counts: { failure?: number; error?: number; pending?: number; none?: number } | undefined): number {
      const c = counts ?? {};
      return (
        Number(c.failure ?? 0) +
        Number(c.error ?? 0) +
        Number(c.pending ?? 0) +
        Number(c.none ?? 0)
      );
    }

    let payload: RepoStatusPayload | null = null;
    let filter: RepoFilter = "all";
    let query = "";

    function matchesQuery(repo: RepoRow): boolean {
      if (!query) return true;
      return [repo.org, repo.name, repo.language, repo.description]
        .map((v) => String(v ?? "").toLowerCase())
        .join(" ")
        .includes(query);
    }

    function repoRow(repo: RepoRow, idx: number): HTMLElement {
      const state = normalizeBuild(repo.build);
      const slug = `${esc(repo.org)}/${esc(repo.name)}`;
      const url = esc(repo.url);
      const meta: string[] = [];
      if (repo.language) meta.push(esc(repo.language));
      if (repo.pushed_at) meta.push(`pushed ${esc(relativeTime(repo.pushed_at))}`);

      const row = document.createElement("article");
      row.className =
        "reveal flex flex-col gap-2 rounded-lg border border-white/5 bg-black/10 px-4 py-3 sm:flex-row sm:items-center sm:justify-between";
      row.style.setProperty("--d", `${Math.min(idx, 12) * 40}ms`);
      row.innerHTML = `
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="h-2 w-2 shrink-0 rounded-full ${buildDotClass(state)}"></span>
            <a href="${url}" rel="noopener" class="truncate font-medium text-slate-100 hover:text-accent">${slug}</a>
            <span class="rounded-full border px-2 py-0.5 text-[11px] font-mono ${buildClass(state)}">${buildLabel(state)}</span>
          </div>
          <p class="mt-1 line-clamp-2 text-sm text-slate-400">${esc(repo.description ?? "")}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-slate-400">
          <a href="${url}/pulls" rel="noopener" class="hover:text-accent">${plural(Number(repo.open_pull_requests ?? 0), "PR", "PRs")}</a>
          <a href="${url}/issues" rel="noopener" class="hover:text-accent">${plural(Number(repo.open_issues ?? 0), "issue", "issues")}</a>
          <span class="text-slate-600">${meta.join(" \u00b7 ")}</span>
        </div>
      `;
      return row;
    }

    function renderPrivate(): void {
      privateEl.innerHTML = "";
      for (const org of payload?.orgs ?? []) {
        const priv = org.private;
        if (!priv || !priv.repo_count) continue;
        const unhealthy = notPassing(priv.builds);

        const el = document.createElement("div");
        el.className =
          "rounded-lg border border-dashed border-white/10 bg-black/10 px-4 py-3 text-sm text-slate-400";
        el.innerHTML = `
          <span class="font-mono text-slate-300">${esc(org.login)}</span>
          \u00b7 ${plural(Number(priv.repo_count), "private repo", "private repos")}, counted but not listed
          <span class="mt-1 block text-xs text-slate-500">
            ${unhealthy > 0 ? `<span class="text-amber-400">${unhealthy} not passing</span> \u00b7 ` : ""}${plural(Number(priv.open_pull_requests ?? 0), "open PR", "open PRs")}
            \u00b7 ${plural(Number(priv.open_issues ?? 0), "open issue", "open issues")}
          </span>
        `;
        privateEl.appendChild(el);
      }
    }

    function renderFilterCounts(): void {
      const repos = payload?.repositories ?? [];
      for (const key of REPO_FILTERS) {
        const btn = root.querySelector<HTMLElement>(`[data-repo-filter="${key}"]`);
        if (!btn) continue;
        const countEl = btn.querySelector<HTMLElement>("[data-repo-filter-count]");
        if (countEl) {
          countEl.textContent = String(
            repos.filter((r) => matchesFilter(r.build, key)).length,
          );
        }
        const selected = key === filter;
        btn.dataset.selected = selected ? "true" : "false";
        btn.setAttribute("aria-pressed", selected ? "true" : "false");
        // Toggle the resting utilities off as well as the accent ones on.
        // Both sets have the same specificity, so leaving `text-slate-300`
        // in place lets stylesheet order decide the colour — and it wins.
        btn.classList.toggle("border-white/10", !selected);
        btn.classList.toggle("bg-black/20", !selected);
        btn.classList.toggle("text-slate-300", !selected);
        btn.classList.toggle("border-accent/50", selected);
        btn.classList.toggle("bg-accent/10", selected);
        btn.classList.toggle("text-accent", selected);
      }
    }

    function renderTotals(): void {
      const totals = payload?.totals;
      const values: Record<string, number> = {
        repositories: Number(totals?.repositories ?? 0),
        attention: notPassing(totals?.builds),
        pull_requests: Number(totals?.open_pull_requests ?? 0),
        issues: Number(totals?.open_issues ?? 0),
      };

      for (const [key, value] of Object.entries(values)) {
        const el = root.querySelector<HTMLElement>(`[data-repo-total="${key}"]`);
        if (!el) continue;
        el.textContent = String(value);
        if (key === "attention") {
          el.classList.toggle("text-amber-400", value > 0);
          el.classList.toggle("text-slate-100", value === 0);
        }
      }
    }

    function renderList(): void {
      const shown = (payload?.repositories ?? []).filter(
        (r) => matchesFilter(r.build, filter) && matchesQuery(r),
      );
      listEl.innerHTML = "";
      shown.forEach((repo, idx) => listEl.appendChild(repoRow(repo, idx)));
      emptyEl.classList.toggle("hidden", shown.length > 0);
    }

    function renderSubtitle(): void {
      const listed = payload?.repositories.length ?? 0;
      const total = Number(payload?.totals.repositories ?? listed);
      const scope =
        total > listed
          ? `${listed} of ${plural(total, "repository", "repositories")} listed`
          : plural(listed, "repository", "repositories");
      subtitleEl.textContent =
        `${scope} \u00b7 default-branch check rollup, open pull requests and open issues`;
    }

    function renderFooter(): void {
      const minutes = Math.max(1, Math.round(Number(payload?.cache_ttl_seconds ?? 0) / 60));
      const parts = [
        `Snapshot taken ${relativeTime(payload?.fetched_at)}`,
        `refreshed at most every ${plural(minutes, "minute", "minutes")}`,
      ];
      if (payload?.private_disclosure === "aggregate") {
        parts.push("private repositories are counted, never named");
      }
      footerEl.textContent = parts.join(" \u00b7 ");

      const isStale = Boolean(payload?.stale);
      staleEl.classList.toggle("hidden", !isStale);
      if (isStale) {
        const ageEl = staleEl.querySelector<HTMLElement>("[data-repo-stale-age]");
        if (ageEl) ageEl.textContent = relativeTime(payload?.fetched_at);
      }
    }

    function render(): void {
      renderSubtitle();
      renderTotals();
      renderFilterCounts();
      renderList();
      renderPrivate();
      renderFooter();
    }

    root.querySelectorAll<HTMLElement>("[data-repo-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        filter = normalizeFilter(btn.dataset.repoFilter);
        renderFilterCounts();
        renderList();
      });
    });

    searchEl.addEventListener("input", () => {
      query = searchEl.value.trim().toLowerCase();
      renderList();
    });

    async function load(): Promise<void> {
      const base = document.documentElement.dataset.apiUrl || "";
      if (!base) {
        root.classList.add("hidden");
        return;
      }
      try {
        const res = await fetch(`${base.replace(/\/$/, "")}/v1/github/status`, {
          cache: "no-store",
        });
        if (!res.ok) {
          root.classList.add("hidden");
          return;
        }
        const json = await res.json();
        payload = (json?.data ?? null) as RepoStatusPayload | null;
        if (!payload) {
          root.classList.add("hidden");
          return;
        }
        render();
      } catch {
        // The board is a panel on a portfolio, not an oncall surface. A dead
        // API hides it rather than leaving a broken shell on the page.
        root.classList.add("hidden");
      }
    }

    void load();
  </script>
</section>
